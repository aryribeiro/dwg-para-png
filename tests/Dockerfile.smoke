# Smoke test no mesmo tipo de ambiente do Streamlit Cloud (Debian slim, sem
# fontes nem pacotes de sistema): prova que bin/dwg2dxf roda e que a suíte
# passa em Linux. Uso: docker build -f tests/Dockerfile.smoke -t dwg-smoke . && docker run --rm dwg-smoke
FROM python:3.12-slim-bookworm
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pytest
COPY . .
RUN chmod +x bin/dwg2dxf && bin/dwg2dxf --version
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider"]
